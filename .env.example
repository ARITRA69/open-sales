# Settings for docker compose. Copy to .env and change what you need.

# The database password. Change it for a real install.
POSTGRES_PASSWORD=open-sales

# Where the API listens on this machine.
SERVER_PORT=8787

# Where Postgres listens on this machine (localhost only).
DB_PORT=5433

# Where people reach this server, e.g. https://sales.example.com.
# Leave empty for http://localhost:8787.
PUBLIC_URL=

# Signs sign-in sessions (at least 32 characters). Leave empty and the server
# makes one and keeps it in the database.
AUTH_SECRET=
