{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/bridge-types.ts",
    "brand.config.json"
  ]
}
