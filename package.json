{
  "name": "open-sales-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted sales pipeline. A desktop app for sales teams that uses each person's own Claude Code or Codex.",
  "license": "MIT",
  "repository": "github:ARITRA69/open-sales",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --filter '@open-sales/*' build",
    "typecheck": "bun run --filter '@open-sales/*' typecheck",
    "lint": "bun run --filter '@open-sales/*' lint",
    "test": "bun run --filter '@open-sales/*' test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css,md}\""
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  }
}
